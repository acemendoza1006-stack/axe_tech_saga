    <!-- Application JavaScript Engine -->
    <script>
        /**
         * WEB AUDIO SYNTHESIZER ENGINE
         * Generates high quality synthesized event SFX on the fly without external MP3 assets
         */
        class SoundboardSynthesizer {
            constructor() {
                this.ctx = null;
            }

            init() {
                if (!this.ctx) {
                    const AudioContext = window.AudioContext || window.webkitAudioContext;
                    this.ctx = new AudioContext();
                }
                if (this.ctx.state === 'suspended') {
                    this.ctx.resume();
                }
            }

            // 1. Fanfare / Victory Chime
            playFanfare(pitch = 1.0, volume = 1.0) {
                this.init();
                const now = this.ctx.currentTime;
                const notes = [261.63, 329.63, 392.00, 523.25, 392.00, 523.25]; // C4, E4, G4, C5, G4, C5
                const times = [0, 0.15, 0.3, 0.45, 0.65, 0.8];
                const durations = [0.12, 0.12, 0.12, 0.18, 0.12, 0.5];

                notes.forEach((freq, idx) => {
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();
                    
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(freq * pitch, now + times[idx]);

                    gain.gain.setValueAtTime(0, now + times[idx]);
                    gain.gain.linearRampToValueAtTime(0.3 * volume, now + times[idx] + 0.02);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + times[idx] + durations[idx]);

                    osc.connect(gain);
                    gain.connect(this.ctx.destination);

                    osc.start(now + times[idx]);
                    osc.stop(now + times[idx] + durations[idx]);
                });
            }

            // 2. Rimshot (Ba-Dum-Tss)
            playRimshot(pitch = 1.0, volume = 1.0) {
                this.init();
                const now = this.ctx.currentTime;

                const osc1 = this.ctx.createOscillator();
                const gain1 = this.ctx.createGain();
                osc1.frequency.setValueAtTime(120 * pitch, now);
                osc1.frequency.exponentialRampToValueAtTime(40 * pitch, now + 0.08);
                gain1.gain.setValueAtTime(0.6 * volume, now);
                gain1.gain.exponentialRampToValueAtTime(0.01, now + 0.08);
                osc1.connect(gain1);
                gain1.connect(this.ctx.destination);
                osc1.start(now);
                osc1.stop(now + 0.08);

                const osc2 = this.ctx.createOscillator();
                const gain2 = this.ctx.createGain();
                osc2.frequency.setValueAtTime(150 * pitch, now + 0.12);
                osc2.frequency.exponentialRampToValueAtTime(50 * pitch, now + 0.22);
                gain2.gain.setValueAtTime(0.6 * volume, now + 0.12);
                gain2.gain.exponentialRampToValueAtTime(0.01, now + 0.22);
                osc2.connect(gain2);
                gain2.connect(this.ctx.destination);
                osc2.start(now + 0.12);
                osc2.stop(now + 0.22);

                const bufferSize = this.ctx.sampleRate * 0.3;
                const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
                const data = buffer.getChannelData(0);
                for (let i = 0; i < bufferSize; i++) {
                    data[i] = Math.random() * 2 - 1;
                }

                const noise = this.ctx.createBufferSource();
                noise.buffer = buffer;

                const filter = this.ctx.createBiquadFilter();
                filter.type = 'highpass';
                filter.frequency.setValueAtTime(5000 * pitch, now + 0.26);

                const gain3 = this.ctx.createGain();
                gain3.gain.setValueAtTime(0.4 * volume, now + 0.26);
                gain3.gain.exponentialRampToValueAtTime(0.001, now + 0.55);

                noise.connect(filter);
                filter.connect(gain3);
                gain3.connect(this.ctx.destination);

                noise.start(now + 0.26);
                noise.stop(now + 0.55);
            }

            // 3. Drum Roll
            playDrumRoll(pitch = 1.0, volume = 1.0) {
                this.init();
                const now = this.ctx.currentTime;
                const totalDuration = 1.8;
                const interval = 0.04;

                for (let t = 0; t < totalDuration; t += interval) {
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();
                    
                    const currentVol = (0.05 + (t / totalDuration) * 0.4) * volume;
                    
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime((180 + Math.random() * 20) * pitch, now + t);

                    gain.gain.setValueAtTime(currentVol, now + t);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + t + 0.035);

                    osc.connect(gain);
                    gain.connect(this.ctx.destination);

                    osc.start(now + t);
                    osc.stop(now + t + 0.035);
                }

                setTimeout(() => {
                    const crashOsc = this.ctx.createOscillator();
                    const crashGain = this.ctx.createGain();
                    crashOsc.frequency.setValueAtTime(80 * pitch, this.ctx.currentTime);
                    crashGain.gain.setValueAtTime(0.7 * volume, this.ctx.currentTime);
                    crashGain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.4);
                    crashOsc.connect(crashGain);
                    crashGain.connect(this.ctx.destination);
                    crashOsc.start();
                    crashOsc.stop(this.ctx.currentTime + 0.4);
                }, totalDuration * 1000);
            }

            // 4. Applause / Cheering Noise
            playApplause(pitch = 1.0, volume = 1.0) {
                this.init();
                const now = this.ctx.currentTime;
                const duration = 2.5;

                const bufferSize = this.ctx.sampleRate * duration;
                const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
                const data = buffer.getChannelData(0);
                let b0 = 0, b1 = 0, b2 = 0, b3 = 0, b4 = 0, b5 = 0, b6 = 0;
                for (let i = 0; i < bufferSize; i++) {
                    const white = Math.random() * 2 - 1;
                    b0 = 0.99886 * b0 + white * 0.0555179;
                    b1 = 0.99332 * b1 + white * 0.0750759;
                    b2 = 0.96900 * b2 + white * 0.1538520;
                    b3 = 0.86650 * b3 + white * 0.3104856;
                    b4 = 0.55000 * b4 + white * 0.5329522;
                    b5 = -0.7616 * b5 - white * 0.0168980;
                    data[i] = b0 + b1 + b2 + b3 + b4 + b5 + b6 + white * 0.5362;
                    data[i] *= 0.11;
                    b6 = white * 0.115926;
                }

                const noise = this.ctx.createBufferSource();
                noise.buffer = buffer;

                const filter = this.ctx.createBiquadFilter();
                filter.type = 'bandpass';
                filter.frequency.setValueAtTime(1200 * pitch, now);
                filter.Q.setValueAtTime(1.2, now);

                const gain = this.ctx.createGain();
                gain.gain.setValueAtTime(0.01, now);
                gain.gain.linearRampToValueAtTime(0.5 * volume, now + 0.4);
                gain.gain.exponentialRampToValueAtTime(0.001, now + duration);

                noise.connect(filter);
                filter.connect(gain);
                gain.connect(this.ctx.destination);

                noise.start(now);
                noise.stop(now + duration);
            }

            // 5. Air Horn / Hype Horn
            playAirHorn(pitch = 1.0, volume = 1.0) {
                this.init();
                const now = this.ctx.currentTime;
                const bursts = [0, 0.18, 0.36];

                bursts.forEach(delay => {
                    const osc1 = this.ctx.createOscillator();
                    const osc2 = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();

                    osc1.type = 'sawtooth';
                    osc2.type = 'sawtooth';

                    osc1.frequency.setValueAtTime(466.16 * pitch, now + delay); 
                    osc2.frequency.setValueAtTime(311.13 * pitch, now + delay); 

                    gain.gain.setValueAtTime(0.4 * volume, now + delay);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + delay + 0.15);

                    osc1.connect(gain);
                    osc2.connect(gain);
                    gain.connect(this.ctx.destination);

                    osc1.start(now + delay);
                    osc2.start(now + delay);
                    osc1.stop(now + delay + 0.15);
                    osc2.stop(now + delay + 0.15);
                });
            }

            // 6. Wrong Answer Buzzer
            playBuzzer(pitch = 1.0, volume = 1.0) {
                this.init();
                const now = this.ctx.currentTime;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();

                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(130 * pitch, now); 

                gain.gain.setValueAtTime(0.5 * volume, now);
                gain.gain.setValueAtTime(0.5 * volume, now + 0.5);
                gain.gain.exponentialRampToValueAtTime(0.001, now + 0.55);

                osc.connect(gain);
                gain.connect(this.ctx.destination);

                osc.start(now);
                osc.stop(now + 0.55);
            }

            // 7. Correct Answer Ding
            playCorrectDing(pitch = 1.0, volume = 1.0) {
                this.init();
                const now = this.ctx.currentTime;
                const notes = [523.25, 659.25, 783.99, 1046.50]; 
                
                notes.forEach((freq, idx) => {
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();

                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(freq * pitch, now + (idx * 0.08));

                    gain.gain.setValueAtTime(0.4 * volume, now + (idx * 0.08));
                    gain.gain.exponentialRampToValueAtTime(0.001, now + (idx * 0.08) + 0.4);

                    osc.connect(gain);
                    gain.connect(this.ctx.destination);

                    osc.start(now + (idx * 0.08));
                    osc.stop(now + (idx * 0.08) + 0.4);
                });
            }

            // 8. Record Scratch
            playRecordScratch(pitch = 1.0, volume = 1.0) {
                this.init();
                const now = this.ctx.currentTime;
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();

                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(800 * pitch, now);
                osc.frequency.exponentialRampToValueAtTime(100 * pitch, now + 0.25);

                gain.gain.setValueAtTime(0.4 * volume, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.25);

                osc.connect(gain);
                gain.connect(this.ctx.destination);

                osc.start(now);
                osc.stop(now + 0.25);
            }

            // 9. Whoosh / Riser Transition
            playWhoosh(pitch = 1.0, volume = 1.0) {
                this.init();
                const now = this.ctx.currentTime;
                const duration = 0.8;

                const bufferSize = this.ctx.sampleRate * duration;
                const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
                const data = buffer.getChannelData(0);
                for (let i = 0; i < bufferSize; i++) {
                    data[i] = Math.random() * 2 - 1;
                }

                const noise = this.ctx.createBufferSource();
                noise.buffer = buffer;

                const filter = this.ctx.createBiquadFilter();
                filter.type = 'bandpass';
                filter.frequency.setValueAtTime(200 * pitch, now);
                filter.frequency.exponentialRampToValueAtTime(3500 * pitch, now + duration);
                filter.Q.setValueAtTime(3.0, now);

                const gain = this.ctx.createGain();
                gain.gain.setValueAtTime(0.01, now);
                gain.gain.linearRampToValueAtTime(0.5 * volume, now + (duration * 0.7));
                gain.gain.exponentialRampToValueAtTime(0.001, now + duration);

                noise.connect(filter);
                filter.connect(gain);
                gain.connect(this.ctx.destination);

                noise.start(now);
                noise.stop(now + duration);
            }

            // 10. Countdown Beep
            playCountdown(pitch = 1.0, volume = 1.0) {
                this.init();
                const now = this.ctx.currentTime;
                const beeps = [0, 0.4, 0.8];

                beeps.forEach((delay, idx) => {
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();

                    const freq = (idx === 2) ? 880 : 440; 
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(freq * pitch, now + delay);

                    gain.gain.setValueAtTime(0.4 * volume, now + delay);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + delay + 0.15);

                    osc.connect(gain);
                    gain.connect(this.ctx.destination);

                    osc.start(now + delay);
                    osc.stop(now + delay + 0.15);
                });
            }
        }

        // Initialize Audio Synthesizer Engine
        const synth = new SoundboardSynthesizer();

        /* 
         * FIXED: Added the missing comma after the 6th object.
         */
        let soundPads = [
            { id: '1', name: 'Drum Roll', category: 'hype', hotkey: '1', icon: 'fa-drum', synthType: 'drumroll', volume: 1.0, isLoop: false, customAudioUrl: '1. Drum Roll.mp3', customImageUrl: 'drum.jpg'},
            { id: '2', name: 'Aray koh', category: 'comedy', hotkey: '2', icon: 'fa-face-laugh-beam', synthType: 'rimshot', volume: 1.0, isLoop: false, customAudioUrl: '2. Aray koh.mp3', customImageUrl: 'aray ko.jpg'},
            { id: '3', name: 'hahahaha', category: 'comedy', hotkey: '3', icon: 'fa-face-laugh-beam', synthType: 'rimshot', volume: 1.0, isLoop: false, customAudioUrl: '3. hahahaha.mp3', customImageUrl: 'hahahaha.jpg'},
            { id: '4', name: 'Applause', category: 'celebration', hotkey: '4', icon: 'fa-hands-clapping', synthType: 'applause', volume: 1.0, isLoop: false, customAudioUrl: '4. Applause.mp3', customImageUrl: 'applause.jpg'},
            { id: '5', name: 'Correct buzzer', category: 'gameshow', hotkey: '5', icon: 'fa-xmark-circle', synthType: 'buzzer', volume: 1.0, isLoop: false, customAudioUrl: '5. Correct buzzer.mp3', customImageUrl: 'correct buzzer.jpg'},
            { id: '6', name: 'Wrong buzzer', category: 'custom', hotkey: 'q', icon: 'fa-bolt', synthType: 'ding', volume: 1.0, isLoop: false, customAudioUrl: '6. Wrong Buzzer.mp3', customImageUrl: 'wrong buzzer.jpg' },
            { id: '7', name: 'Oh No!', category: 'comedy', hotkey: '6', icon: 'fa-triangle-exclamation', synthType: 'scratch', volume: 1.0, isLoop: false, customAudioUrl: '7. Oh No!.mp3', customImageUrl: 'Oh no!.jpg'},
            { id: '8', name: 'We Are the Champions', category: 'celebration', hotkey: '7', icon: 'fa-trophy', synthType: 'fanfare', volume: 1.0, isLoop: false, customAudioUrl: '8. We Are the Champions.mp3', customImageUrl: 'we are the champion.jpg'},
            { id: '9', name: 'shet nakita ako', category: 'comedy', hotkey: '8', icon: 'fa-wind', synthType: 'whoosh', volume: 1.0, isLoop: false, customAudioUrl: '9. shet nakita ako.mp3', customImageUrl: 'kuya dogs.jpg'},
            { id: '10', name: "Who's Next_", category: 'gameshow', hotkey: '9', icon: 'fa-stopwatch', synthType: 'countdown', volume: 1.0, isLoop: false, customAudioUrl: '10. Whos Next_.mp3', customImageUrl: 'whos next.jpg'},
            { id: '11', name: 'WoW', category: 'celebration', hotkey: '0', icon: 'fa-star', synthType: 'ding', volume: 1.0, isLoop: false, customAudioUrl: '11. WoW.mp3', customImageUrl: 'wow.jpg'},
        ];

        // Active state tracker
        let activeCategory = 'all';
        let activeAudioSources = {};  
        let activeLoopIntervals = {};

        // DOM Element Selectors
        const padsGrid = document.getElementById('padsGrid');
        const emptyState = document.getElementById('emptyState');
        const masterVolumeInput = document.getElementById('masterVolume');
        const masterVolVal = document.getElementById('masterVolVal');
        const masterPitchInput = document.getElementById('masterPitch');
        const masterPitchVal = document.getElementById('masterPitchVal');
        const stopAllBtn = document.getElementById('stopAllBtn');
        const searchInput = document.getElementById('searchInput');
        const categoryContainer = document.getElementById('categoryContainer');

        // Modal DOM Selectors
        const openAddModalBtn = document.getElementById('openAddModalBtn');
        const soundModal = document.getElementById('soundModal');
        const modalBox = document.getElementById('modalBox');
        const closeModalBtn = document.getElementById('closeModalBtn');
        const cancelModalBtn = document.getElementById('cancelModalBtn');
        const soundForm = document.getElementById('soundForm');
        const soundFileInput = document.getElementById('soundFileInput');
        const fileChooseText = document.getElementById('fileChooseText');
        const removeAudioBtn = document.getElementById('removeAudioBtn');
        
        // Image Modal DOM Selectors
        const soundImageInput = document.getElementById('soundImageInput');
        const imageChooseText = document.getElementById('imageChooseText');
        const imagePreview = document.getElementById('imagePreview');
        const removeImageBtn = document.getElementById('removeImageBtn');

        // Render Sound Pads to UI
        function renderPads() {
            padsGrid.innerHTML = '';
            
            const searchTerm = searchInput.value.toLowerCase().trim();

            const filteredPads = soundPads.filter(pad => {
                const matchesCategory = (activeCategory === 'all') || (pad.category === activeCategory);
                const matchesSearch = pad.name.toLowerCase().includes(searchTerm) || pad.hotkey.toLowerCase().includes(searchTerm);
                return matchesCategory && matchesSearch;
            });

            if (filteredPads.length === 0) {
                emptyState.classList.remove('hidden');
                emptyState.classList.add('flex');
            } else {
                emptyState.classList.add('hidden');
                emptyState.classList.remove('flex');
            }

            filteredPads.forEach(pad => {
                const isPlaying = !!activeAudioSources[pad.id];
                const padCard = document.createElement('div');
                
                padCard.className = `pad-btn relative bg-brand-card hover:bg-opacity-80 border ${isPlaying ? 'border-brand-500 shadow-glow' : 'border-brand-border'} rounded-2xl p-4 flex flex-col justify-between cursor-pointer transition-all duration-150 group h-36 overflow-hidden`;
                padCard.dataset.padId = pad.id;

                // Determine what to show inside the icon box (Image or FontAwesome Icon)
                const iconContent = pad.customImageUrl 
                    ? `<img src="${pad.customImageUrl}" class="w-full h-full object-cover">` 
                    : `<i class="fa-solid ${pad.icon}"></i>`;

                padCard.innerHTML = `
                    <!-- Top Info Header -->
                    <div class="flex items-center justify-between">
                        <span class="text-[10px] font-bold uppercase tracking-widest text-brand-400 bg-brand-dark px-2 py-0.5 rounded border border-brand-border font-mono">
                            ${pad.category}
                        </span>
                        <div class="flex items-center gap-1.5">
                            <button class="loop-btn text-xs text-gray-400 hover:text-brand-500 ${pad.isLoop ? 'text-brand-500 font-bold' : ''} p-1" title="Toggle Sound Loop">
                                <i class="fa-solid fa-rotate-right"></i>
                            </button>
                            <button class="edit-btn text-xs text-gray-400 hover:text-white p-1" title="Edit Pad">
                                <i class="fa-solid fa-ellipsis-vertical"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Center Sound Title & Icon -->
                    <div class="flex items-center gap-3 my-2">
                        <!-- Image / Icon Container -->
                        <div class="w-10 h-10 rounded-xl ${isPlaying ? 'bg-brand-500 text-white shadow-glow' : 'bg-brand-dark text-brand-500'} flex items-center justify-center text-lg group-hover:scale-110 transition-transform border border-brand-border overflow-hidden">
                            ${iconContent}
                        </div>
                        <div class="flex-1 min-w-0">
                            <h4 class="text-xs font-bold text-white truncate flex items-center gap-1 font-mono tracking-wide">
                                ${pad.name}
                                ${pad.customAudioUrl ? '<i class="fa-solid fa-music text-[10px] text-brand-400 ml-1" title="Custom Audio Attached"></i>' : ''}
                            </h4>
                            <span class="text-[10px] text-gray-500 font-mono tracking-wider">KEY: <kbd class="px-1 py-0.2 bg-brand-dark border border-brand-border rounded text-brand-400 font-bold">${pad.hotkey.toUpperCase()}</kbd></span>
                        </div>
                    </div>

                    <!-- Bottom Controls & Equalizer Indicator -->
                    <div class="flex items-center justify-between pt-2 border-t border-brand-border/50">
                        <!-- Equalizer Animation (Shown when playing) -->
                        <div class="flex items-end gap-0.5 h-3 ${isPlaying ? 'opacity-100' : 'opacity-0'} transition-opacity">
                            <span class="w-1 bg-brand-500 rounded-full eq-bar"></span>
                            <span class="w-1 bg-brand-500 rounded-full eq-bar"></span>
                            <span class="w-1 bg-brand-500 rounded-full eq-bar"></span>
                            <span class="w-1 bg-brand-500 rounded-full eq-bar"></span>
                        </div>

                        <!-- Volume Slider per pad -->
                        <div class="flex items-center gap-1.5" onclick="event.stopPropagation();">
                            <i class="fa-solid fa-volume-low text-[10px] text-gray-500"></i>
                            <input type="range" min="0" max="1" step="0.1" value="${pad.volume}" class="pad-vol-slider w-12 cursor-pointer">
                        </div>
                    </div>
                `;

                // Event listener to trigger sound
                padCard.addEventListener('click', (e) => {
                    if (e.target.closest('.loop-btn') || e.target.closest('.edit-btn') || e.target.closest('.pad-vol-slider')) return;
                    playSound(pad.id);
                });

                // Loop toggle click
                const loopBtn = padCard.querySelector('.loop-btn');
                loopBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    pad.isLoop = !pad.isLoop;
                    renderPads();
                });

                // Edit pad click
                const editBtn = padCard.querySelector('.edit-btn');
                editBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    openEditModal(pad);
                });

                // Pad level volume adjust
                const padVolSlider = padCard.querySelector('.pad-vol-slider');
                padVolSlider.addEventListener('input', (e) => {
                    pad.volume = parseFloat(e.target.value);
                });

                padsGrid.appendChild(padCard);
            });
        }

        // Core Sound Dispatcher Function
        function playSound(padId) {
            const pad = soundPads.find(p => p.id === padId);
            if (!pad) return;

            const masterVol = parseFloat(masterVolumeInput.value);
            const masterPitch = parseFloat(masterPitchInput.value);
            const finalVol = pad.volume * masterVol;

            // Stop sound if already playing non-looping toggle
            if (activeAudioSources[pad.id]) {
                stopSound(pad.id);
                return;
            }

            activeAudioSources[pad.id] = true;
            renderPads();

            // Execute Custom Audio File OR Audio Synthesizer
            if (pad.customAudioUrl) {
                const audio = new Audio(pad.customAudioUrl);
                audio.volume = finalVol;
                audio.playbackRate = masterPitch;
                audio.loop = pad.isLoop;
                
                audio.play().catch(err => console.log('Audio playback prevented:', err));
                activeAudioSources[pad.id] = audio;

                audio.onended = () => {
                    if (!pad.isLoop) {
                        delete activeAudioSources[pad.id];
                        renderPads();
                    }
                };
            } else {
                // Synthesized Web Audio
                const triggerSynth = () => {
                    switch (pad.synthType) {
                        case 'fanfare': synth.playFanfare(masterPitch, finalVol); break;
                        case 'rimshot': synth.playRimshot(masterPitch, finalVol); break;
                        case 'drumroll': synth.playDrumRoll(masterPitch, finalVol); break;
                        case 'applause': synth.playApplause(masterPitch, finalVol); break;
                        case 'airhorn': synth.playAirHorn(masterPitch, finalVol); break;
                        case 'buzzer': synth.playBuzzer(masterPitch, finalVol); break;
                        case 'ding': synth.playCorrectDing(masterPitch, finalVol); break;
                        case 'scratch': synth.playRecordScratch(masterPitch, finalVol); break;
                        case 'whoosh': synth.playWhoosh(masterPitch, finalVol); break;
                        case 'countdown': synth.playCountdown(masterPitch, finalVol); break;
                    }
                };

                triggerSynth();

                if (pad.isLoop) {
                    activeLoopIntervals[pad.id] = setInterval(triggerSynth, 2000);
                } else {
                    setTimeout(() => {
                        delete activeAudioSources[pad.id];
                        renderPads();
                    }, 1200);
                }
            }
        }

        // Stop Specific Sound Pad
        function stopSound(padId) {
            if (activeAudioSources[padId]) {
                if (typeof activeAudioSources[padId] === 'object' && activeAudioSources[padId].pause) {
                    activeAudioSources[padId].pause();
                    activeAudioSources[padId].currentTime = 0;
                }
                delete activeAudioSources[padId];
            }
            if (activeLoopIntervals[padId]) {
                clearInterval(activeLoopIntervals[padId]);
                delete activeLoopIntervals[padId];
            }
            renderPads();
        }

        // Panic Stop All Button
        stopAllBtn.addEventListener('click', () => {
            Object.keys(activeAudioSources).forEach(padId => stopSound(padId));
            Object.keys(activeLoopIntervals).forEach(padId => {
                clearInterval(activeLoopIntervals[padId]);
                delete activeLoopIntervals[padId];
            });
            activeAudioSources = {};
            renderPads();
        });

        // Global Keyboard Event Listener for Hotkeys
        window.addEventListener('keydown', (e) => {
            if (['INPUT', 'SELECT', 'TEXTAREA'].includes(document.activeElement.tagName)) return;

            const keyPressed = e.key.toLowerCase();
            const matchingPad = soundPads.find(p => p.hotkey.toLowerCase() === keyPressed);

            if (matchingPad) {
                e.preventDefault();
                playSound(matchingPad.id);
            }
        });

        // Master Volume slider update
        masterVolumeInput.addEventListener('input', (e) => {
            masterVolVal.textContent = `${Math.round(e.target.value * 100)}%`;
        });

        // Master Pitch slider update
        masterPitchInput.addEventListener('input', (e) => {
            masterPitchVal.textContent = `${parseFloat(e.target.value).toFixed(1)}x`;
        });

        // Category Filter Tabs
        categoryContainer.addEventListener('click', (e) => {
            const chip = e.target.closest('.cat-chip');
            if (!chip) return;

            document.querySelectorAll('.cat-chip').forEach(c => {
                c.classList.remove('bg-brand-500', 'text-white', 'shadow-glow');
                c.classList.add('bg-brand-dark', 'text-gray-300');
            });

            chip.classList.remove('bg-brand-dark', 'text-gray-300');
            chip.classList.add('bg-brand-500', 'text-white', 'shadow-glow');

            activeCategory = chip.dataset.category;
            renderPads();
        });

        // Live Search Input Filter
        searchInput.addEventListener('input', () => {
            renderPads();
        });

        // Modal Controls
        function toggleModal(show = true) {
            if (show) {
                soundModal.classList.remove('opacity-0', 'pointer-events-none');
                modalBox.classList.remove('scale-95');
                modalBox.classList.add('scale-100');
            } else {
                soundModal.classList.add('opacity-0', 'pointer-events-none');
                modalBox.classList.remove('scale-100');
                modalBox.classList.add('scale-95');
                soundForm.reset();
                document.getElementById('editPadId').value = '';
                
                // Reset audio UI
                fileChooseText.textContent = 'Select Audio File';
                removeAudioBtn.classList.add('hidden');
                
                // Reset image UI
                imageChooseText.textContent = 'Select Image (JPG, PNG)';
                imagePreview.classList.add('hidden');
                imagePreview.src = '';
                removeImageBtn.classList.add('hidden');
            }
        }

        openAddModalBtn.addEventListener('click', () => {
            document.getElementById('modalTitle').innerHTML = '<i class="fa-solid fa-plus-circle text-brand-500"></i> Load Custom Patch';
            toggleModal(true);
        });

        closeModalBtn.addEventListener('click', () => toggleModal(false));
        cancelModalBtn.addEventListener('click', () => toggleModal(false));

        // Audio File Input Change
        soundFileInput.addEventListener('change', (e) => {
            if (e.target.files.length > 0) {
                fileChooseText.textContent = `Selected: ${e.target.files[0].name}`;
            }
        });

        // Image File Input Change
        soundImageInput.addEventListener('change', (e) => {
            if (e.target.files.length > 0) {
                const file = e.target.files[0];
                const objectUrl = URL.createObjectURL(file);
                imageChooseText.textContent = `Selected: ${file.name}`;
                imagePreview.src = objectUrl;
                imagePreview.classList.remove('hidden');
                removeImageBtn.classList.remove('hidden');
            }
        });

        // Handle removing the custom audio file from a pad
        removeAudioBtn.addEventListener('click', () => {
            const padId = document.getElementById('editPadId').value;
            const pad = soundPads.find(p => p.id === padId);
            if (pad) {
                pad.customAudioUrl = null;
                fileChooseText.textContent = 'Select Audio File';
                removeAudioBtn.classList.add('hidden');
                soundFileInput.value = ''; 
            }
        });

        // Handle removing the custom image from a pad
        removeImageBtn.addEventListener('click', () => {
            imagePreview.src = '';
            imagePreview.classList.add('hidden');
            imageChooseText.textContent = 'Select Image (JPG, PNG)';
            removeImageBtn.classList.add('hidden');
            soundImageInput.value = ''; 
            
            // If editing an existing pad, remove it from the data model instantly
            const padId = document.getElementById('editPadId').value;
            const pad = soundPads.find(p => p.id === padId);
            if (pad) {
                pad.customImageUrl = null;
            }
        });

        function openEditModal(pad) {
            document.getElementById('modalTitle').innerHTML = '<i class="fa-solid fa-pen-to-square text-brand-500"></i> Edit Patch';
            document.getElementById('editPadId').value = pad.id;
            document.getElementById('soundNameInput').value = pad.name;
            document.getElementById('soundCategoryInput').value = pad.category;
            document.getElementById('soundHotkeyInput').value = pad.hotkey;
            document.getElementById('soundIconInput').value = pad.icon;
            
            // Check if pad already has a custom audio file attached
            if (pad.customAudioUrl) {
                fileChooseText.textContent = 'Custom audio attached. Click to replace.';
                removeAudioBtn.classList.remove('hidden');
            } else {
                fileChooseText.textContent = 'Select Audio File';
                removeAudioBtn.classList.add('hidden');
            }

            // Check if pad already has a custom image attached
            if (pad.customImageUrl) {
                imageChooseText.textContent = 'Custom image attached. Click to replace.';
                imagePreview.src = pad.customImageUrl;
                imagePreview.classList.remove('hidden');
                removeImageBtn.classList.remove('hidden');
            } else {
                imageChooseText.textContent = 'Select Image (JPG, PNG)';
                imagePreview.classList.add('hidden');
                imagePreview.src = '';
                removeImageBtn.classList.add('hidden');
            }
            
            toggleModal(true);
        }

        // Custom Sound Form Submission
        soundForm.addEventListener('submit', (e) => {
            e.preventDefault();

            const padId = document.getElementById('editPadId').value;
            const name = document.getElementById('soundNameInput').value.trim();
            const category = document.getElementById('soundCategoryInput').value;
            const hotkey = document.getElementById('soundHotkeyInput').value.trim().toLowerCase() || 'a';
            const icon = document.getElementById('soundIconInput').value;
            const audioFile = soundFileInput.files[0];
            const imageFile = soundImageInput.files[0];

            if (padId) {
                // Editing existing pad
                const pad = soundPads.find(p => p.id === padId);
                if (pad) {
                    pad.name = name;
                    pad.category = category;
                    pad.hotkey = hotkey;
                    pad.icon = icon;
                    
                    // If a new audio file is uploaded, create object URL and assign
                    if (audioFile) {
                        pad.customAudioUrl = URL.createObjectURL(audioFile);
                    }
                    
                    // If a new image file is uploaded, create object URL and assign
                    if (imageFile) {
                        pad.customImageUrl = URL.createObjectURL(imageFile);
                    }
                }
            } else {
                // Creating new custom pad
                const newPad = {
                    id: Date.now().toString(),
                    name: name,
                    category: category,
                    hotkey: hotkey,
                    icon: icon,
                    volume: 1.0,
                    isLoop: false,
                    customAudioUrl: audioFile ? URL.createObjectURL(audioFile) : null,
                    customImageUrl: imageFile ? URL.createObjectURL(imageFile) : null,
                    synthType: audioFile ? null : 'ding' // Fallback synth if no audio file uploaded
                };
                soundPads.unshift(newPad);
            }

            toggleModal(false);
            renderPads();
        });

        // Initialize App on Page Load
        window.addEventListener('load', () => {
            renderPads();
        });
    </script>
