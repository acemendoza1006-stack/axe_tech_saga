<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AXE TECH SAGA - Modern Synth Soundboard Studio</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&family=Share+Tech+Mono&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Poppins', 'sans-serif'],
                        mono: ['Share Tech Mono', 'monospace'],
                    },
                    colors: {
                        brand: {
                            50: '#fff0f5',
                            100: '#ffe3ed',
                            400: '#f50057',
                            500: '#ff4081',
                            600: '#e91e63',
                            700: '#c2185b',
                            dark: '#0f111a',
                            card: '#1a1d2d',
                            border: '#2a2e45'
                        }
                    },
                    boxShadow: {
                        'glow': '0 0 15px rgba(255, 64, 129, 0.4)',
                        'glow-lg': '0 0 25px rgba(255, 64, 129, 0.6)',
                        'pad-active': 'inset 0 2px 4px rgba(0,0,0,0.6), 0 0 15px rgba(255,64,129,0.8)'
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background-color: #0b0c14;
            color: #e2e8f0;
            user-select: none;
        }
        
        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #0f111a;
        }
        ::-webkit-scrollbar-thumb {
            background: #2a2e45;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #ff4081;
        }

        /* Sound Pad Pressed effect */
        .pad-btn:active {
            transform: translateY(2px) scale(0.98);
        }

        /* Equalizer Animation Bar */
        .eq-bar {
            animation: bounce 0.6s ease-in-out infinite alternate;
        }
        @keyframes bounce {
            0% { height: 15%; }
            100% { height: 100%; }
        }
        .eq-bar:nth-child(1) { animation-delay: 0.1s; }
        .eq-bar:nth-child(2) { animation-delay: 0.3s; }
        .eq-bar:nth-child(3) { animation-delay: 0.2s; }
        .eq-bar:nth-child(4) { animation-delay: 0.4s; }

        /* Custom range slider styling */
        input[type=range] {
            accent-color: #ff4081;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col font-sans overflow-x-hidden">

    <!-- Header Section -->
